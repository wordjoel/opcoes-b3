# Copie para .env.turso (ignorado pelo git) e preencha. Na Vercel, cadastre como variáveis do projeto.
# Sem TURSO_DATABASE_URL, o desenvolvimento local usa o arquivo .b3-local.db.
TURSO_DATABASE_URL="libsql://SEU-BANCO.turso.io"
TURSO_AUTH_TOKEN=""
BRAPI_API_KEY=""
# Gerados por: python -m scripts.hash_password
APP_PASSWORD_HASH=""
SESSION_SECRET=""
# Protege a varredura diária (/api/cron/scan). Pelo menos 32 caracteres aleatórios.
CRON_SECRET=""
# Só em desenvolvimento sem HTTPS:
# B3_INSECURE_COOKIE=1

# Jarbas IA: basta uma chave. Ordem padrão: OpenRouter, Gemini, Groq (mude no painel do Jarbas).
# Ficam só no servidor (Vercel > Settings > Environment Variables), nunca no navegador.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcionais: trocar o modelo de cada provedor.
JARBAS_GEMINI_MODEL=gemini-2.5-flash
JARBAS_GROQ_MODEL=llama-3.3-70b-versatile
# Vários modelos separados por vírgula: tentados em ordem. Os gratuitos mudam; confira em openrouter.ai/models.
JARBAS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
# Opcional: qualquer servidor compatível com a API de chat da OpenAI (por exemplo, um agente próprio).
JARBAS_CUSTOM_BASE_URL=
JARBAS_CUSTOM_API_KEY=
JARBAS_CUSTOM_MODEL=
JARBAS_CUSTOM_LABEL=
