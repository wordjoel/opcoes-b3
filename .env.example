# Copie para .env.turso (ignorado pelo git) e preencha. Na Vercel, cadastre como variáveis do projeto.
# Sem TURSO_DATABASE_URL, o desenvolvimento local usa o arquivo .b3-local.db.
TURSO_DATABASE_URL="libsql://SEU-BANCO.turso.io"
TURSO_AUTH_TOKEN=""
BRAPI_API_KEY=""
# Gerados por: python -m scripts.hash_password
APP_PASSWORD_HASH=""
SESSION_SECRET=""
# Protege a varredura diária (/api/cron/scan). Pelo menos 32 caracteres aleatórios.
CRON_SECRET=""
# Só em desenvolvimento sem HTTPS:
# B3_INSECURE_COOKIE=1
